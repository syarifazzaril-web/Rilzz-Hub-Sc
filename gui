-- ═══════════════════════════════════════════════════════════
--  LAUNCH
-- ═══════════════════════════════════════════════════════════
local loadSteps = {
	{t="Loading assets...",  p=0.28},
	{t="Building layout...", p=0.60},
	{t="Applying theme...",  p=0.84},
	{t="Done.",              p=1.00},
}

local function runLoad(i, cb)
	if i > #loadSteps then task.wait(0.15); cb(); return end
	local s = loadSteps[i]
	progLbl.Text = s.t
	Tween(progFill, {Size=UDim2.new(s.p,0,1,0)}, 0.35)
	task.delay(0.4, function() runLoad(i+1, cb) end)
end

task.delay(0.25, function()
	runLoad(1, function()
		Tween(loadBg,{BackgroundTransparency=1},0.35)
		task.delay(0.38, function()
			loadGui:Destroy()
			win.Visible = true
			win.Size = UDim2.new(0,580,0,0)
			Tween(win, {Size=UDim2.new(0,580,0,415)}, 0.38, Enum.EasingStyle.Back)
		end)
	end)
end)

