-- ── MINIMIZE / EXPAND ─────────────────────────────────────
local minimized = false

local function doMinimize()
	minimized = true
	win.Visible = false
	pill.Size   = UDim2.new(0,0,0,52)
	pill.BackgroundTransparency = 1
	pill.Visible = true
	Tween(pill, {Size=UDim2.new(0,200,0,52), BackgroundTransparency=0}, 0.32, Enum.EasingStyle.Back)
end

local function doExpand()
	minimized = false
	pill.Visible = false
	win.Size    = UDim2.new(0,580,0,0)
	win.Visible = true
	Tween(win, {Size=UDim2.new(0,580,0,415)}, 0.35, Enum.EasingStyle.Back)
end

minBtn.MouseButton1Click:Connect(doMinimize)

