function RilzHub:AddToggle(p,t,d,v)        addToggle(p,t,d,v)                      end
function RilzHub:AddSlider(p,t,pct,col)    addSlider(p,t,pct,col)                  end
function RilzHub:AddTextbox(p,t,ph)        addTextbox(p,t,ph)                      end
function RilzHub:AddDropdown(p,t,opts,def) addDropdown(p,t,opts,def)               end
function RilzHub:AddColorPicker(p,t,c,cb)  addColorPicker(p,t,c,cb)               end
function RilzHub:AddButton(p,t,btype)      addButton(p,t,btype)                    end
function RilzHub:AddSection(p,text)        Sec(p,text)                             end
function RilzHub:AddDivider(p)             Div(p)                                  end

return RilzHub
